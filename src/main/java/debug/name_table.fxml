<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<GridPane hgap="20" style="-fx-background-color: #fffaf0; -fx-padding: 20;" vgap="20" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.debug.NameTableController">

    <!-- Row 0 -->
    <Label text="Name Table 0:" GridPane.columnIndex="0" GridPane.rowIndex="0">
        <font><Font name="Consolas Bold" size="12.0" /></font>
    </Label>
    <Label text="Name Table 1:" GridPane.columnIndex="1" GridPane.rowIndex="0">
        <font><Font name="Consolas Bold" size="12.0" /></font>
    </Label>

    <!-- Row 1: Canvases NT0 and NT1 -->
    <Canvas fx:id="nameTable0" height="240" width="256" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <Canvas fx:id="nameTable1" height="240" width="256" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <!-- Row 2 -->
    <Label text="Name Table 2:" GridPane.columnIndex="0" GridPane.rowIndex="2">
        <font><Font name="Consolas Bold" size="12.0" /></font>
    </Label>
    <Label text="Name Table 3:" GridPane.columnIndex="1" GridPane.rowIndex="2">
        <font><Font name="Consolas Bold" size="12.0" /></font>
    </Label>

    <!-- Row 3: Canvases NT2 and NT3 -->
    <Canvas fx:id="nameTable2" height="240" width="256" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <Canvas fx:id="nameTable3" height="240" width="256" GridPane.columnIndex="1" GridPane.rowIndex="3" />
   <columnConstraints>
      <ColumnConstraints />
      <ColumnConstraints />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
   </rowConstraints>

</GridPane>
